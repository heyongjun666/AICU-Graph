# Runtime data
nodes/
workspaces/
runtime_sessions/
# 只忽略仓库根级的运行产物。不能写成不带斜杠的 `events*`：那样会在**任意层级**按
# 文件名匹配（本仓库 core.ignorecase=true，连 `EventStore.ts` 也命中），把
# frontend/src/{stores/EventStore.ts,components/EventsDialog.tsx} 一起挡在 git 之外 ——
# 而这两个文件是被已提交代码 import 的，导致 clone 下来前端编译不过。
/events*
/shared/
/event_inbox/
*.log
router_traces.jsonl
review_v*.md
test_report.md

# Credentials and local configuration
.env
.env.*
!.env.example
api_keys.json
config.local.*
sessions.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Frontend
node_modules/
dist/
frontend/node_modules/
frontend/dist/

# Local tooling and OS files
.DS_Store
